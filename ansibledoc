h4. Qué queda en el repo

{code:language=yaml|linenumbers=false}
# inventories/prod/hosts.yml — GENERADO desde la hoja. No editar a mano.
all:
  children:
    app_payments_management:
      hosts:
        pay-prd-01.banamex.internal: { ansible_host: 10.30.1.11 }
# inventories/cob/hosts.yml tiene el mismo grupo con pay-cob-01

# inventories/prod/group_vars/app_payments_management.yml — GENERADO
