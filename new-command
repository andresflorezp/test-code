git rev-list --objects --all |
  git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' |
  Where-Object { $_ -like 'blob *' } |
  ForEach-Object {
      $p = $_ -split ' ', 4
      if ([long]$p[2] -gt 104857600) { $p[1] }
  } |
  Set-Content -Encoding ascii "$env:USERPROFILE\blobs-grandes.txt"
