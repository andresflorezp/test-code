<mxfile host="app.diagrams.net"><diagram id="p0" name="1 · Diseño del CI"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="CI del repo deploy-playbooks" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=22;fontColor=#2C2C2A;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Un solo pipeline. Cada PR corre solo lo que le toca. Para hacer merge todo tiene que salir bien. AAP se actualiza solo. Todo corre en runners de GitHub." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=13;fontColor=#5F5E5A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1800" height="24" as="geometry"/></mxCell><mxCell id="fpr" value="En cada PR" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5F5E5A;dashed=1;fontColor=#2C2C2A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="1340" height="470" as="geometry"/></mxCell><mxCell id="fmain" value="Después del merge" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F6E56;dashed=1;fontColor=#04342C;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1630" y="90" width="300" height="470" as="geometry"/></mxCell><mxCell id="dev" value='&lt;b&gt;Equipo de automatización&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;roles y playbooks&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="200" height="80" as="geometry"/></mxCell><mxCell id="hoja" value='&lt;b&gt;Equipo de migración&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;la hoja: Excel hoy, app mañana&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="200" height="80" as="geometry"/></mxCell><mxCell id="pr" value='&lt;b&gt;Pull Request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;hacia main&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="120" height="70" as="geometry"/></mxCell><mxCell id="chg" value='&lt;b&gt;1 · ¿Qué cambió?&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;prende solo lo necesario&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="265" width="150" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888780;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="dev" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888780;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="hoja" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888780;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pr" target="chg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lcod" value="Carril código · el detalle está más abajo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#534AB7;dashed=1;fontColor=#3C3489;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="790" height="150" as="geometry"/></mxCell><mxCell id="fee" value="Dentro del EE de cada familia" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3C3489;dashed=1;fontColor=#26215C;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11.5;fillColor=#F7F6FE;" vertex="1" parent="1"><mxGeometry x="632" y="140" width="500" height="108" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b&gt;2 · Revisar el código&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;yamllint · ansible-lint · syntax&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="645" y="168" width="230" height="68" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b&gt;3 · Contrato con ROP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;el portero acepta lo bueno y rechaza lo malo&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="890" y="168" width="230" height="68" as="geometry"/></mxCell><mxCell id="s4" value='&lt;b&gt;4 · Probar los roles&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;Molecule, en el runner&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="168" width="230" height="68" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ldat" value="Carril datos · el detalle está más abajo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1D6F42;dashed=1;fontColor=#173404;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="280" width="790" height="130" as="geometry"/></mxCell><mxCell id="d0" value='&lt;b&gt;5 · Revisar la hoja&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;reglas, error en la fila&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="318" width="175" height="75" as="geometry"/></mxCell><mxCell id="d1" value='&lt;b&gt;6 · Inventarios al día&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;nadie los editó a mano&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="832" y="318" width="175" height="75" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6F42;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value='&lt;b&gt;7 · ¿AAP los lee?&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;los 6 inventarios cargan&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1024" y="318" width="175" height="75" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6F42;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value='&lt;b&gt;8 · Resumen en el PR&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;qué cambia · ⚠ prod/cob&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1216" y="318" width="175" height="75" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6F42;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lcom" value="Siempre, o según lo que cambió" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5F5E5A;dashed=1;fontColor=#2C2C2A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="790" height="115" as="geometry"/></mxCell><mxCell id="s9" value='&lt;b&gt;9 · Buscar secretos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;gitleaks, en todos los PR&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="462" width="360" height="65" as="geometry"/></mxCell><mxCell id="s10" value='&lt;b&gt;10 · Probar la app de alta&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;solo si cambió la app&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1020" y="462" width="370" height="65" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="chg" target="lcod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6F42;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="chg" target="ldat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F5E5A;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="chg" target="lcom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="487"/></Array></mxGeometry></mxCell><mxCell id="gate" value='&lt;b&gt;11 · ci-ok&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;¿salió todo bien?&lt;/font&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#633806;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="280" width="150" height="130" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="lcod" target="gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1515" y="185"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ldat" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="lcom" target="gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1515" y="487"/></Array></mxGeometry></mxCell><mxCell id="gtxt" value="lo que no aplicó no cuenta" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;fontColor=#633806;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="420" width="80" height="80" as="geometry"/></mxCell><mxCell id="rev" value='&lt;b&gt;12 · Alguien lo aprueba&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;CODEOWNERS · prod/cob: el dueño de la app&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="merge" value="&lt;b&gt;13 · Merge a main&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;fontSize=13;spacing=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1650" y="230" width="260" height="50" as="geometry"/></mxCell><mxCell id="aap" value='&lt;b&gt;14 · AAP se actualiza solo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;Antes de cada despliegue baja lo último de main y recarga el inventario (&lt;i&gt;update on launch&lt;/i&gt;).&lt;br&gt;&lt;br&gt;AAP sale a buscar a GitHub: GitHub no necesita entrar al banco.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="310" width="260" height="230" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888780;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gate" target="rev"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1620" y="345"/><mxPoint x="1620" y="165"/></Array></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888780;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rev" target="merge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6E56;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="merge" target="aap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value='&lt;div style="font-size:15px;font-weight:bold;margin-bottom:6px"&gt;Las ideas clave&lt;/div&gt;&lt;ul style="margin:0;padding-left:20px;font-size:12.5px;line-height:1.45"&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;El PR es la única puerta&lt;/b&gt; a main y a AAP. El CI es el guardia de la puerta.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;Las revisiones de código corren dentro del EE&lt;/b&gt;: misma imagen que usa AAP, así lo que pasa en el PR pasa en AAP.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;La hoja dice dónde, los roles dicen cómo, ROP dice cuándo&lt;/b&gt;; el CI garantiza que las tres cosas cuadren.&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="900" height="130" as="geometry"/></mxCell><mxCell id="n2" value='&lt;div style="font-size:15px;font-weight:bold;margin-bottom:6px"&gt;Runners de GitHub&lt;/div&gt;&lt;ul style="margin:0;padding-left:20px;font-size:12.5px;line-height:1.45"&gt;&lt;li style="margin-bottom:5px"&gt;No llegan a la red del banco: las imágenes de CI viven en &lt;b&gt;GHCR&lt;/b&gt;, armadas con la misma definición del EE de AAP.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;Nada en el pipeline llama a AAP: &lt;b&gt;AAP se actualiza solo&lt;/b&gt;. Pruebas contra AAP real (despliegue de prueba en dev) quedan para cuando haya red privada para runners.&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="960" y="590" width="970" height="130" as="geometry"/></mxCell><mxCell id="b_band" value="" style="line;strokeWidth=2;strokeColor=#D3D1C7;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="1890" height="4" as="geometry"/></mxCell><mxCell id="b_ttl" value="Carril código en detalle y el contrato con ROP" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=22;fontColor=#2C2C2A;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1800" height="34" as="geometry"/></mxCell><mxCell id="b_sub" value="Pasos 2, 3 y 4 de arriba. El contrato tiene dos niveles: el portero revisa el sobre del pedido (lo que traen todos) y cada rol revisa su contenido (lo que necesita ese tipo)." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=13;fontColor=#5F5E5A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="1800" height="24" as="geometry"/></mxCell><mxCell id="b_fee" value="Dentro del EE de cada familia (linux, openshift, windows, api) · imagen de CI en GHCR = EE de AAP + ansible-lint, yamllint, pytest" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3C3489;dashed=1;fontColor=#26215C;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#F7F6FE;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1050" height="240" as="geometry"/></mxCell><mxCell id="b_s2" value='&lt;div style="font-size:14px;font-weight:bold;margin-bottom:5px"&gt;2 · Revisar el código&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Qué hace:&lt;/b&gt; &lt;b&gt;yamllint&lt;/b&gt;: que el YAML esté bien escrito. &lt;b&gt;ansible-lint&lt;/b&gt; (nivel production): buenas prácticas. &lt;b&gt;syntax-check&lt;/b&gt;: cada playbook abre como lo haría AAP.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Atrapa:&lt;/b&gt; una contraseña sin &lt;i&gt;no_log&lt;/i&gt; que saldría en el log, un módulo sin nombre completo, un &lt;i&gt;include_role&lt;/i&gt; mal escrito.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Si falla:&lt;/b&gt; archivo, línea y regla que rompió.&lt;/div&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="895" width="500" height="180" as="geometry"/></mxCell><mxCell id="b_s3" value='&lt;div style="font-size:14px;font-weight:bold;margin-bottom:5px"&gt;3 · Contrato con ROP&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Qué hace:&lt;/b&gt; prueba al portero con pedidos de ejemplo (&lt;i&gt;tests/contract/&lt;/i&gt;): los buenos tienen que pasar y los malos ser rechazados. Revisa también que catálogo y roles cuadren.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Atrapa:&lt;/b&gt; que alguien borre sin querer una regla (por ejemplo, la del ticket) o que un rol no exista en el catálogo.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Si falla:&lt;/b&gt; «DEBIÓ FALLAR: prod-sin-change.json» y el PR queda en rojo.&lt;/div&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="575" y="895" width="500" height="180" as="geometry"/></mxCell><mxCell id="b_s4" value='&lt;div style="font-size:14px;font-weight:bold;margin-bottom:5px"&gt;4 · Probar los roles&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Qué hace:&lt;/b&gt; &lt;b&gt;Molecule&lt;/b&gt; corre el rol que cambió contra un servidor de mentiras (un contenedor RHEL), dos veces.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Atrapa:&lt;/b&gt; un rol que no deja las cosas donde dice, o que cambia algo la segunda vez (no es idempotente).&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Si falla:&lt;/b&gt; la tarea que falló.&lt;br&gt;&lt;br&gt;Corre en el runner de GitHub con docker, fuera del EE, porque necesita levantar contenedores.&lt;/div&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1110" y="850" width="460" height="240" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b_s2" target="b_s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b_fct" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#993556;dashed=1;fontColor=#4B1528;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1530" height="470" as="geometry"/></mxCell><mxCell id="b_ctt" value="El contrato con ROP: así se revisa un pedido cuando llega a AAP" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=16;fontColor=#4B1528;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1132" width="1400" height="30" as="geometry"/></mxCell><mxCell id="b_c1" value='&lt;div style="width:330px"&gt;&lt;div style="font-size:14px;font-weight:bold"&gt;El pedido de ROP&lt;/div&gt;&lt;div style="font-size:12px;margin:3px 0 8px"&gt;Lo que manda en extra_vars al lanzar el Job Template.&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:11.5px;line-height:1.45;background:#FFFFFF;border:1px solid #D3D1C7;border-radius:4px;padding:8px;color:#2C2C2A"&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;contract_version&amp;quot;:&amp;nbsp;&amp;quot;3&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;app_id&amp;quot;:&amp;nbsp;&amp;quot;portal&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;deploy_type&amp;quot;:&amp;nbsp;&amp;quot;java_appserver_was&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;environment_name&amp;quot;:&amp;nbsp;&amp;quot;uat&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;change_id&amp;quot;:&amp;nbsp;&amp;quot;CHG0012345&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;app_config&amp;quot;:&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;install_path&amp;quot;:&amp;nbsp;&amp;quot;/opt/apps/portal&amp;quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;app_vars&amp;quot;:&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;DB_PASS&amp;quot;:&amp;nbsp;&amp;quot;vault:…/uat#db&amp;quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;/div&gt;&lt;/div&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#4B1528;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1175" width="360" height="300" as="geometry"/></mxCell><mxCell id="b_c2" value='&lt;div style="width:490px"&gt;&lt;div style="font-size:14px;font-weight:bold"&gt;Nivel 1 · El portero revisa el sobre&lt;/div&gt;&lt;div style="font-size:12px;margin:3px 0 8px"&gt;contract_check: reglas que aplican a todos los tipos. Lee del catálogo qué tipos acepta cada familia, así un tipo nuevo no obliga a tocarlo.&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:11.5px;line-height:1.45;background:#FFFFFF;border:1px solid #D3D1C7;border-radius:4px;padding:8px;color:#2C2C2A"&gt;-&amp;nbsp;ok:&amp;nbsp;contract_version&amp;nbsp;==&amp;nbsp;&amp;#x27;3&amp;#x27;&lt;br&gt;-&amp;nbsp;ok:&amp;nbsp;app_id&amp;nbsp;con&amp;nbsp;formato&amp;nbsp;válido&lt;br&gt;-&amp;nbsp;ok:&amp;nbsp;environment_name&amp;nbsp;es&amp;nbsp;uno&amp;nbsp;de&amp;nbsp;los&amp;nbsp;6&lt;br&gt;-&amp;nbsp;ok:&amp;nbsp;deploy_type&amp;nbsp;es&amp;nbsp;de&amp;nbsp;esta&amp;nbsp;familia&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;#&amp;nbsp;←&amp;nbsp;sale&amp;nbsp;de&amp;nbsp;data/catalogo.json&lt;br&gt;-&amp;nbsp;ok:&amp;nbsp;viene&amp;nbsp;app_config&lt;br&gt;-&amp;nbsp;ok:&amp;nbsp;de&amp;nbsp;uat&amp;nbsp;en&amp;nbsp;adelante&amp;nbsp;hay&amp;nbsp;change_id&lt;br&gt;&lt;br&gt;FAILED:&amp;nbsp;Pedido&amp;nbsp;rechazado:&amp;nbsp;de&amp;nbsp;uat&amp;nbsp;en&lt;br&gt;adelante&amp;nbsp;el&amp;nbsp;pedido&amp;nbsp;necesita&amp;nbsp;change_id&lt;/div&gt;&lt;/div&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="450" y="1175" width="520" height="300" as="geometry"/></mxCell><mxCell id="b_c3" value='&lt;div style="width:520px"&gt;&lt;div style="font-size:14px;font-weight:bold"&gt;Nivel 2 · El rol revisa el contenido&lt;/div&gt;&lt;div style="font-size:12px;margin:3px 0 8px"&gt;meta/argument_specs.yml de cada rol: lo que necesita ESE tipo. Ansible lo revisa solo, antes de la primera tarea.&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:11.5px;line-height:1.45;background:#FFFFFF;border:1px solid #D3D1C7;border-radius:4px;padding:8px;color:#2C2C2A"&gt;#&amp;nbsp;roles/deploy_java_appserver_was/&lt;br&gt;#&amp;nbsp;&amp;nbsp;&amp;nbsp;meta/argument_specs.yml&lt;br&gt;options:&lt;br&gt;&amp;nbsp;&amp;nbsp;app_id:&amp;nbsp;{type:&amp;nbsp;str,&amp;nbsp;required:&amp;nbsp;true}&lt;br&gt;&amp;nbsp;&amp;nbsp;app_config:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;type:&amp;nbsp;dict&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;required:&amp;nbsp;true&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;options:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;install_path:&amp;nbsp;{type:&amp;nbsp;str,&amp;nbsp;required:&amp;nbsp;true}&lt;br&gt;&lt;br&gt;FAILED:&amp;nbsp;missing&amp;nbsp;required&amp;nbsp;arguments:&lt;br&gt;install_path&amp;nbsp;found&amp;nbsp;in&amp;nbsp;app_config&lt;/div&gt;&lt;/div&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1175" width="550" height="300" as="geometry"/></mxCell><mxCell id="b_ok" value='&lt;b&gt;✓ Pasa los dos niveles → despliega&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;Si falla cualquiera, el job termina en failed sin tocar ningún servidor y ROP ve el motivo exacto.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="1490" width="550" height="85" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#993556;strokeWidth=2;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b_c1" target="b_c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#993556;strokeWidth=2;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b_c2" target="b_c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F6E56;strokeWidth=2;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b_c3" target="b_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b_nct" value='&lt;div style="font-size:15px;font-weight:bold;margin-bottom:6px"&gt;En una frase&lt;/div&gt;&lt;ul style="margin:0;padding-left:20px;font-size:12.5px;line-height:1.45"&gt;&lt;li style="margin-bottom:5px"&gt;El contrato es el formulario que ROP llena. El portero revisa el sobre, el rol revisa el contenido, y el CI (paso 3) revisa al portero con formularios buenos y malos de ejemplo.&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#4B1528;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1490" width="910" height="85" as="geometry"/></mxCell><mxCell id="c_band" value="" style="line;strokeWidth=2;strokeColor=#D3D1C7;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1658" width="1890" height="4" as="geometry"/></mxCell><mxCell id="c_ttl" value="Carril datos en detalle y la hoja de inventario" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=22;fontColor=#2C2C2A;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1660" width="1800" height="34" as="geometry"/></mxCell><mxCell id="c_sub" value="Pasos 5 a 8 de arriba. La hoja dice en qué servidores vive cada app en cada entorno. De ella salen los inventarios de AAP; nadie los edita a mano." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=13;fontColor=#5F5E5A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1696" width="1800" height="24" as="geometry"/></mxCell><mxCell id="c_h0" value='&lt;div style="font-size:14px;font-weight:bold;margin-bottom:5px"&gt;5 · Revisar la hoja&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Qué hace:&lt;/b&gt; aplica las reglas fila por fila: entorno válido, tipo de despliegue que exista, campos obligatorios llenos… (las reglas finales salen cuando se cierre la hoja).&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Atrapa:&lt;/b&gt; un entorno dev1, una app de Windows en un RHEL, la misma app con dos CSI.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Si falla:&lt;/b&gt; el error sale en la fila del CSV dentro del PR: «fila 42 · cmdb_ci».&lt;/div&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1745" width="355" height="205" as="geometry"/></mxCell><mxCell id="c_h1" value='&lt;div style="font-size:14px;font-weight:bold;margin-bottom:5px"&gt;6 · Inventarios al día&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Qué hace:&lt;/b&gt; arma los inventarios desde la hoja y los compara con los del PR.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Atrapa:&lt;/b&gt; a alguien que editó inventories/ a mano, sin validación ni aprobación.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Si falla:&lt;/b&gt; qué inventario no cuadra y el comando para regenerarlo.&lt;/div&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="420" y="1745" width="355" height="205" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6F42;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_h0" target="c_h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_h2" value='&lt;div style="font-size:14px;font-weight:bold;margin-bottom:5px"&gt;7 · ¿AAP los puede leer?&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Qué hace:&lt;/b&gt; abre los 6 inventarios con ansible-inventory, igual que AAP.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Atrapa:&lt;/b&gt; un inventario roto que dejaría a todo un entorno sin poder desplegar.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Si falla:&lt;/b&gt; el error de Ansible con archivo y línea.&lt;/div&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="800" y="1745" width="355" height="205" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6F42;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_h1" target="c_h2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_h3" value='&lt;div style="font-size:14px;font-weight:bold;margin-bottom:5px"&gt;8 · Resumen en el PR&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Qué hace:&lt;/b&gt; compara con main y escribe en el PR: filas nuevas, cambiadas o quitadas, apps nuevas y entornos tocados.&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.4;margin-bottom:5px"&gt;&lt;b&gt;Atrapa:&lt;/b&gt; nada: es para que quien aprueba entienda el cambio en 10 segundos. Marca ⚠ si toca prod o cob.&lt;/div&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="1745" width="355" height="205" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6F42;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_h2" target="c_h3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_campos" value='&lt;div style="font-size:15px;font-weight:bold;margin-bottom:6px"&gt;La hoja · &lt;i&gt;en definición&lt;/i&gt;&lt;/div&gt;&lt;ul style="margin:0;padding-left:20px;font-size:12.5px;line-height:1.45"&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;Una fila&lt;/b&gt; = un servidor, en un entorno, con una app.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;Trae datos del &lt;b&gt;servidor&lt;/b&gt; (nombre, entorno, estado…), de la &lt;b&gt;app&lt;/b&gt; (app_id, CSI, tipo de despliegue) y, si es OpenShift, la API del clúster.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;No se llenan a mano&lt;/b&gt;: familia, Job Template, ola y grupos de Ansible. Los calcula el CI.&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="1975" width="480" height="165" as="geometry"/></mxCell><mxCell id="c_napp" value='&lt;div style="font-size:15px;font-weight:bold;margin-bottom:6px"&gt;La app de alta (más adelante)&lt;/div&gt;&lt;ul style="margin:0;padding-left:20px;font-size:12.5px;line-height:1.45"&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;No necesita base de datos para empezar:&lt;/b&gt; el repo es la base. Al guardar, la app abre el PR con un usuario bot.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;El PR arranca el CI solo.&lt;/b&gt; Nadie lanza nada.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;&lt;b&gt;Base de datos propia&lt;/b&gt; solo si hacen falta borradores o aprobaciones dentro de la app.&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="545" y="1975" width="480" height="165" as="geometry"/></mxCell><mxCell id="c_npend" value='&lt;div style="font-size:15px;font-weight:bold;margin-bottom:6px"&gt;Lo que falta definir de la hoja&lt;/div&gt;&lt;ul style="margin:0;padding-left:20px;font-size:12.5px;line-height:1.45"&gt;&lt;li style="margin-bottom:5px"&gt;Las &lt;b&gt;columnas finales&lt;/b&gt; y cuáles son obligatorias.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;Qué pasa con un servidor que se da de &lt;b&gt;baja&lt;/b&gt;.&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;Quién aprueba los cambios de cada app (&lt;b&gt;CODEOWNERS&lt;/b&gt; por CSI).&lt;/li&gt;&lt;li style="margin-bottom:5px"&gt;Si los inventarios generados se guardan en el repo o se arman al vuelo.&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#633806;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1050" y="1975" width="485" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 · Agregar un tipo nuevo"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="Agregar un tipo de despliegue nuevo (un rol nuevo)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=22;fontColor=#2C2C2A;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Qué se toca en el repo, qué revisa el CI de cada cosa y qué tiene que saber ROP. El portero (contract_check) ya no se toca: lee el catálogo." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=13;fontColor=#5F5E5A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1800" height="24" as="geometry"/></mxCell><mxCell id="t1" value='&lt;b&gt;1 · El catálogo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;&lt;font face="Courier New"&gt;data/catalogo.json&lt;/font&gt;&lt;br&gt;Agregas el tipo con su familia, ola y estado. Es la fuente de verdad: de aquí leen el portero, la hoja y la app.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="95" as="geometry"/></mxCell><mxCell id="t2" value='&lt;b&gt;2 · El rol&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;&lt;font face="Courier New"&gt;roles/deploy_&amp;lt;tipo&amp;gt;/tasks/&lt;/font&gt;&lt;br&gt;El código del despliegue.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="520" height="95" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t3" value='&lt;b&gt;3 · Qué necesita del pedido&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;&lt;font face="Courier New"&gt;roles/deploy_&amp;lt;tipo&amp;gt;/meta/argument_specs.yml&lt;/font&gt;&lt;br&gt;Los campos de app_config que necesita este tipo. Es lo que le pasas al equipo de ROP.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="520" height="95" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4" value='&lt;b&gt;4 · Un pedido de ejemplo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;&lt;font face="Courier New"&gt;tests/contract/validos/&amp;lt;tipo&amp;gt;-uat.json&lt;/font&gt;&lt;br&gt;Un pedido bueno para este tipo. Si tiene reglas propias, también uno malo en invalidos/.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="520" height="95" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5" value='&lt;b&gt;5 · Su prueba&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;&lt;font face="Courier New"&gt;roles/deploy_&amp;lt;tipo&amp;gt;/molecule/&lt;/font&gt;&lt;br&gt;El servidor de mentiras para probarlo. Cuando se pueda.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="520" height="95" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tpr" value='&lt;b&gt;Pull Request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;el CI revisa todo lo de arriba&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;fontSize=13;spacing=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="520" height="60" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#534AB7;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="t5" target="tpr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fck" value="Qué te avisa el CI si se te olvida algo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BA7517;dashed=1;fontColor=#633806;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="600" height="670" as="geometry"/></mxCell><mxCell id="k1" value='&lt;b&gt;Hay un rol deploy_x pero x no está en el catálogo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;error · PR en rojo&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#633806;fontSize=13;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="560" height="100" as="geometry"/></mxCell><mxCell id="k2" value='&lt;b&gt;Hay un tipo en el catálogo sin su rol&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;aviso · normal mientras se construyen las olas&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="252" width="560" height="100" as="geometry"/></mxCell><mxCell id="k3" value='&lt;b&gt;Un rol no tiene argument_specs.yml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;aviso · «no dice qué campos necesita del pedido»&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="374" width="560" height="100" as="geometry"/></mxCell><mxCell id="k4" value='&lt;b&gt;El portero rechaza un pedido bueno o acepta uno malo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;error · fallan los pedidos de ejemplo&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#633806;fontSize=13;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="496" width="560" height="100" as="geometry"/></mxCell><mxCell id="k5" value='&lt;b&gt;El rol no hace lo que dice o no es idempotente&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;error · Molecule&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#BA7517;fontColor=#633806;fontSize=13;spacing=8;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="618" width="560" height="100" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t1" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t2" target="k2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t3" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t4" target="k4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BA7517;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5;fontSize=11.5;fontColor=#5F5E5A;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t5" target="k5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="frop" value="Del lado de ROP" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#993556;dashed=1;fontColor=#4B1528;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="90" width="520" height="670" as="geometry"/></mxCell><mxCell id="r1" value='&lt;b&gt;Self Service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;El mapeo deploy_type → familia → Job Template, y los valores por defecto del tipo (lo común a todas las apps de ese tipo).&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#4B1528;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1280" y="130" width="480" height="130" as="geometry"/></mxCell><mxCell id="r2" value='&lt;b&gt;Release Ops Store&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;Para cada app de ese tipo, los campos de app_config que pide el argument_specs del rol (paso 3 de la izquierda). Es lo propio de cada app.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#4B1528;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1280" y="290" width="480" height="130" as="geometry"/></mxCell><mxCell id="r3" value='&lt;b&gt;El contrato no cambia de versión&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;Agregar un tipo no cambia el sobre del pedido. Solo sube la versión si cambian los campos que traen todos.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#993556;fontColor=#4B1528;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1280" y="450" width="480" height="110" as="geometry"/></mxCell><mxCell id="r4" value='&lt;b&gt;La hoja ya puede usar el tipo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;En cuanto el tipo está en el catálogo y su rol existe, las apps de ese tipo se pueden dar de alta en la hoja y el paso 5 las acepta.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F2EA;strokeColor=#1D6F42;fontColor=#173404;fontSize=13;spacing=8;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1280" y="590" width="480" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>