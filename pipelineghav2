        required: true
jobs:
  ci:
    uses: ‹org›/reusable-workflows/.github/workflows/ci-template.yml@v1
    with:
      config: pipeline.yaml
      vendor-version: ${{ inputs.version }}   # se entrega al sh como la variable de hoy
    secrets: inherit
